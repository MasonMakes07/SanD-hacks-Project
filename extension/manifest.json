{
  "manifest_version": 3,
  "name": "TruthTrace — Follow the evidence",
  "description": "Check a selected claim or article and inspect the sources behind the result.",
  "version": "0.1.0",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "sidePanel", "storage", "scripting"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_title": "Open TruthTrace" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'self' http://127.0.0.1:* http://localhost:*"
  }
}
