# Copy this file to .env (git-ignored) and fill in real values there.
# Never put real credentials in this file.

BRIGHTDATA_API_KEY=

BRIGHTDATA_SERP_ZONE=serp_api3
BRIGHTDATA_TIMEOUT_S=15
# Neon PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL=
