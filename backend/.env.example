# Copy to backend/.env and fill in. Never commit backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Model for YouTube video checks, and the backup model raced against slow calls.
GEMINI_VIDEO_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Seconds before a slow Gemini call is raced against the backup model.
GEMINI_HEDGE_SECONDS=4
VIDEO_TIMEOUT_SECONDS=30
FACTCHECK_API_KEY=
# Shared secret the extension sends in the X-TruthTrace-Key header.
TRUTHTRACE_API_KEY=
# true = /api/analyze always returns the fixed mock response.
USE_MOCK=false
# Lock to your extension id once known, e.g. ^chrome-extension://abcd...$
ALLOWED_ORIGIN_REGEX=^chrome-extension://[a-p]{32}$
REQUEST_TIMEOUT_SECONDS=12
ANALYZE_TIMEOUT_SECONDS=90
RATE_LIMIT_PER_MINUTE=20
MAX_BODY_BYTES=100000
